{
  "name": "api-produtos-ci",
  "version": "1.0.0",
  "description": "API REST de produtos (CRUD) com Node.js, TypeScript, Express e PostgreSQL, usada para demonstrar um workflow de CI no GitHub Actions.",
  "main": "dist/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.build.json && node dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "security:sast": "eslint --config eslint.security.config.mjs src",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "build": "tsc -p tsconfig.build.json",
    "test:unit": "jest --selectProjects unit --verbose",
    "test:integration": "jest --selectProjects integration --runInBand --verbose"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
